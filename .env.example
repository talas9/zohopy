# ZohoPy Configuration
# Copy to .env and fill in your values, or run: zohopy setup
# NEVER commit .env — it is in .gitignore.

# Required — OAuth credentials from https://api-console.zoho.com/
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Required — generated by `zohopy setup`
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_DATA_CENTER=us

# Optional — overrides ZOHO_DATA_CENTER if set
# ZOHO_API_DOMAIN=https://www.zohoapis.com
